# Copy to scripts/.deploy.env (gitignored) and fill in the pooler connection
# strings from each Supabase project's Dashboard → Project Settings → Database →
# Connection string (URI). These enable `db push` in deploy-supabase.sh.
#
# Leave a URL blank/unset to skip that environment's migrations (functions still
# deploy).

# Dev project (wgdjjpimubqbplzrdqpg)
export DEV_DB_URL="postgresql://postgres.wgdjjpimubqbplzrdqpg:[PASSWORD]!@aws-1-us-west-1.pooler.supabase.com:5432/postgres"

# Prod project (zknpsrphbfdbzsjilzpg)
export PROD_DB_URL="postgresql://postgres.zknpsrphbfdbzsjilzpg:[PASSWORD]!@aws-1-us-west-1.pooler.supabase.com:5432/postgres"

# Optional ref overrides (defaults are baked into the script):
# export DEV_PROJECT_REF="wgdjjpimubqbplzrdqpg"
# export PROD_PROJECT_REF="zknpsrphbfdbzsjilzpg"
v