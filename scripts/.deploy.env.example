# Copy to scripts/.deploy.env (gitignored) and fill in the connection strings
# from each Supabase project's Dashboard → Project Settings → Database →
# Connection string (URI). These enable `db push` in deploy-supabase.sh.
#
# Leave a URL blank/unset to skip that environment's migrations (functions still
# deploy).

# Dev project (zknpsrphbfdbzsjilzpg — local app / kathryn-classic-dev)
export DEV_DB_URL="postgresql://postgres:PASSWORD@db.zknpsrphbfdbzsjilzpg.supabase.co:5432/postgres"

# Prod project (wgdjjpimubqbplzrdqpg — Vercel / www.kathrynclassic.com)
export PROD_DB_URL="postgresql://postgres:PASSWORD@db.wgdjjpimubqbplzrdqpg.supabase.co:5432/postgres"

# Optional ref overrides (defaults are baked into the script):
# export DEV_PROJECT_REF="zknpsrphbfdbzsjilzpg"
# export PROD_PROJECT_REF="wgdjjpimubqbplzrdqpg"
